# Copy to .env (never commit it). Docker Compose reads this file automatically.

# --- Required for production sign-in ---
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# Must match the exact origin you open in the browser (scheme + host + port).
# Local Docker: http://localhost:10000
# Public HTTPS: https://hub.example.com
BETTER_AUTH_URL=http://localhost:10000

# Sign-in already trusts whatever origin the request was addressed to (Host /
# X-Forwarded-*), so BETTER_AUTH_URL is optional for email+password. Set
# BETTER_AUTH_STRICT_ORIGINS=true to trust ONLY BETTER_AUTH_URL + the list below.
# Extra origins allowed to sign in (comma-separated) — LAN IPs, extra domains.
# Loopback variants (localhost / 127.0.0.1 / [::1]) of BETTER_AUTH_URL are auto-trusted.
# BETTER_AUTH_TRUSTED_ORIGINS=https://hub.example.com,http://192.168.1.50:10000

# Render: leave BETTER_AUTH_URL unset on the default onrender.com URL (the app uses
# RENDER_EXTERNAL_URL). Set it only for a custom domain.
# Postgres overlay password (docker-compose.postgres.yml). Change it for any non-local deploy.
# POSTGRES_PASSWORD=hub

# --- Database ---
# Leave empty to use embedded PGLite (persisted at PGLITE_DATA_DIR in Docker).
# Postgres example:
# DATABASE_URL=postgres://hub:hub@db:5432/knowledge_hub
DATABASE_URL=

# Optional: where PGLite stores files when DATABASE_URL is unset (Docker default).
# PGLITE_DATA_DIR=/app/data/pglite

# --- Optional client STT keys (also enterable in the UI; stored in localStorage) ---
# VITE_DEEPGRAM_API_KEY=67f27fc6663be3bd48b5c663d5285c4a70161d15
# VITE_WHISPER_API_KEY=
